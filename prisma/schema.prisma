datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

generator client {
  provider = "prisma-client-js"
}

model SystemParameter {
  id    String @id @default(cuid())
  key   String @unique // e.g. SESSION_VAT_PERCENTAGE, COMMISSION_PERCENTAGE, ALP_SHARE_PERCENTAGE
  value Float
}

model Location {
  id               String             @id @default(cuid())
  name             String
  fixedRent        Float
  duesAmount       Float
  rentVatRate      Float
  revenueShareRate Float              @default(0) // Ciro Payı %
  revenueThreshold Float              @default(0) // Ciro Eşiği (TL)
  isActive         Boolean            @default(true)
  performances     MonthlyPerformance[]
  dailyPerformances DailyPerformance[]
  expenses         Expense[]
  investments      Investment[]
}

model DailyPerformance {
  id           String   @id @default(cuid())
  locationId   String
  location     Location @relation(fields: [locationId], references: [id])
  date         DateTime
  sessionCount Int      @default(0)
  testCount    Int      @default(0)
  extraMetrics Json?    // To store custom fields dynamically

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([locationId, date])
}

model MonthlyPerformance {
  id                 String   @id @default(cuid())
  locationId         String
  location           Location @relation(fields: [locationId], references: [id])
  month              DateTime // First day of the month
  sessionCount       Float    
  extraExpenseAmount Float    @default(0)
  extraExpenseNotes  String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Expense {
  id               String    @id @default(cuid())
  locationId       String?   // Can be global (null) or local
  location         Location? @relation(fields: [locationId], references: [id])
  description      String
  type             String    // "RECURRING" or "ONE_TIME"
  amountWithoutVat Float
  isOfficial       Boolean   @default(false)
  vatRate          Float     @default(0)
  amountWithVat    Float
  month            String?   // YYYY-MM for one-time tracking
  paidBy           String    @default("Ortak Hesap")
  categoryId       String?

  createdAt        DateTime  @default(now())
  attachmentUrl    String?
  isSettled        Boolean   @default(false)
}

model Investment {
  id               String   @id @default(cuid())
  locationId       String
  location         Location @relation(fields: [locationId], references: [id])
  description      String
  currency         String   @default("TL")
  amountWithoutVat Float
  paymentType      String   @default("Nakit")
  vatAmount        Float    @default(0)
  totalAmount      Float
  shareLogic       String?
  notes            String?  

  createdAt        DateTime @default(now())
}

model Note {
  id        String   @id @default(cuid())
  userId    String?  // The user who owns this note
  title     String
  content   String?
  color     String   @default("zinc") // To store tag/color info
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String   // CREATE, UPDATE, DELETE
  entity    String   // Expense, Investment, etc.
  entityId  String
  details   String?  // JSON string or formatted text
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

model Document {
  id          String   @id @default(cuid())
  fileUrl     String
  fileName    String?
  relatedType String   // expense, investment
  relatedId   String
  uploadedAt  DateTime @default(now())
}
