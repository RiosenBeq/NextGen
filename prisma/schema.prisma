datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model SystemParameter {
  id    String @id @default(cuid())
  key   String @unique // e.g. SESSION_VAT_PERCENTAGE, COMMISSION_PERCENTAGE, ALP_SHARE_PERCENTAGE
  value Float
}

model Location {
  id               String               @id @default(cuid())
  name             String
  fixedRent        Float
  duesAmount       Float
  rentVatRate      Float
  isActive         Boolean              @default(true)
  performances     MonthlyPerformance[]
  expenses         Expense[]
  investments      Investment[]
}

model MonthlyPerformance {
  id                 String   @id @default(cuid())
  locationId         String
  location           Location @relation(fields: [locationId], references: [id])
  month              DateTime // First day of the month
  sessionCount       Float    
  extraExpenseAmount Float    @default(0)
  extraExpenseNotes  String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Expense {
  id               String    @id @default(cuid())
  locationId       String?   // Can be global (null) or local
  location         Location? @relation(fields: [locationId], references: [id])
  description      String
  type             String    // "aylık" or "tek sefer"
  amountWithoutVat Float
  isOfficial       Boolean   @default(false)
  vatRate          Float     @default(0)
  amountWithVat    Float
  month            String?   // YYYY-MM for one-time tracking

  createdAt        DateTime  @default(now())
}

model Investment {
  id               String   @id @default(cuid())
  locationId       String
  location         Location @relation(fields: [locationId], references: [id])
  description      String
  currency         String   @default("TL")
  amountWithoutVat Float
  paymentType      String   @default("Nakit")
  vatAmount        Float    @default(0)
  totalAmount      Float
  shareLogic       String?
  notes            String?  

  createdAt        DateTime @default(now())
}

model Cabin {
  id                 String             @id @default(cuid())
  cabinId            Int                @unique // Original ID from osessensin API
  firmId             Int                
  cabinName          String
  cabinLocation      String
  cabinPrice         Float
  startDate          DateTime?
  macAddresses       String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  
  dailyStats         CabinDailyStat[]
}

model CabinDailyStat {
  id                 String   @id @default(cuid())
  cabinId            String
  cabin              Cabin    @relation(fields: [cabinId], references: [id])
  date               String   // YYYY-MM-DD
  todayRevenue       Float
  paidSessions       Int
  incomingCustomer   Int
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([cabinId, date])
}
